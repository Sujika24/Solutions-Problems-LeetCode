class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int left=1;
        int right=0;
        for(int pile:piles){
            right=Math.max(right,pile);
        }
        while(left<=right){
            int mid=left+(right-left)/2;
            long c=0;
            for(int pile:piles){
                c+=(pile+mid-1)/mid;
            }
            if(c<=h){
                right=mid-1;
            }else{
                left=mid+1;
            }
        }
        return left;
    }
}


Example 1:

Input: piles = [3,6,7,11], h = 8
Output: 4
Example 2:

Input: piles = [30,11,23,4,20], h = 5
Output: 30
Example 3:

Input: piles = [30,11,23,4,20], h = 6
Output: 23
