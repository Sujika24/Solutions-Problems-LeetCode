class Solution {
    public int maxConsecutiveAnswers(String answerKey, int k) {
       int n=answerKey.length();
       char[] arr=answerKey.toCharArray();
       int left=0;
       int Tc=0;
       int Fc=0;
       int max=0;
       for(int right=0;right<n;right++){
        if(arr[right]=='T'){
            Tc++;
        }else{
            Fc++;
        } 
        while(Math.min(Tc,Fc)>k){   
            if(arr[left]=='T'){
                Tc--;
            }
            else{
                Fc--;
            }
            left++;    
        }
        int l=right-left+1;
        if(l>max){
            max=l;
        }
       }
       return max;
    }
}




