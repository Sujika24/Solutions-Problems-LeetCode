class Solution {
    public int[] sortedSquares(int[] nums) {
        int n=nums.length;
        int left=0;
        int right=n-1;
        for(int i=0;i<n;i++){
            nums[i]*=nums[i];
        }
        int res[]=new int[n];
        int ind=n-1;
        while(left<=right){
            if(nums[left]>nums[right]){
                res[ind]=nums[left];
                left++;
            }else{
                res[ind]=nums[right];
                right--;
            }
            ind--;
        }
        return res;
    }
}



Example 1:

Input: nums = [-4,-1,0,3,10]
Output: [0,1,9,16,100]
Explanation: After squaring, the array becomes [16,1,0,9,100].
After sorting, it becomes [0,1,9,16,100].

